{
  "version": 1,
  "defaults": {
    "dns": {
      "resolvers": [
        "1.1.1.1",
        "8.8.8.8",
        "9.9.9.9"
      ],
      "timeout_seconds": 2.0,
      "lifetime_seconds": 4.0,
      "negative_votes_required": 2,
      "suspect_after_hours": 72,
      "quarantine_after_hours": 168,
      "expire_after_hours": 720,
      "negative_streak_max_gap_hours": 48,
      "suspect_min_negative_observations": 3,
      "quarantine_min_negative_observations": 7,
      "max_workers": 20
    },
    "service_check": {
      "enabled": true,
      "port": 443,
      "path": "/",
      "timeout_seconds": 4.0,
      "max_workers": 10,
      "max_ipv4_per_host": 3,
      "suspect_after_hours": 72,
      "dead_after_hours": 168,
      "failure_streak_max_gap_hours": 48,
      "suspect_min_failure_observations": 3,
      "dead_min_failure_observations": 7,
      "history_days": 14,
      "history_max_entries": 256,
      "failure_log_limit": 50,
      "user_agent": "DKHNV-DNS-Maintenance/1.0"
    }
  },
  "collections": [
    {
      "name": "grok",
      "active_file": "Grok_DNS",
      "data_dir": "dns/grok",
      "discovery": {
        "enabled": true,
        "sources": [
          {
            "type": "certspotter",
            "id": "grok-core",
            "roots": [
              "grok.com"
            ],
            "max_pages_per_root": 1,
            "request_timeout_seconds": 30.0,
            "user_agent": "DKHNV-DNS-Maintenance/1.0"
          },
          {
            "type": "certspotter",
            "id": "xai-core",
            "roots": [
              "x.ai"
            ],
            "max_pages_per_root": 1,
            "request_timeout_seconds": 30.0,
            "user_agent": "DKHNV-DNS-Maintenance/1.0"
          },
          {
            "type": "certspotter",
            "id": "grok-user-content",
            "roots": [
              "grokusercontent.com"
            ],
            "max_pages_per_root": 1,
            "request_timeout_seconds": 30.0,
            "user_agent": "DKHNV-DNS-Maintenance/1.0"
          },
          {
            "type": "certspotter",
            "id": "grok-sandbox",
            "roots": [
              "grok-sandbox.com"
            ],
            "max_pages_per_root": 1,
            "request_timeout_seconds": 30.0,
            "user_agent": "DKHNV-DNS-Maintenance/1.0"
          }
        ]
      },
      "hostname_policy": {
        "enabled": true,
        "allow": [],
        "exclude": [
          {
            "id": "exclude-personal-bskarabahaty-a",
            "match": "exact",
            "value": "bskarabahaty.hades-api.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-bskarabahaty-b",
            "match": "exact",
            "value": "hades-bskarabahaty.api.gcp.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-dpfeifer-a",
            "match": "exact",
            "value": "dpfeifer.hades-api.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-dpfeifer-b",
            "match": "exact",
            "value": "hades-dpfeifer.api.gcp.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-francischong-a",
            "match": "exact",
            "value": "francischong.hades-api.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-francischong-b",
            "match": "exact",
            "value": "hades-francischong.api.gcp.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-ikruk-a",
            "match": "exact",
            "value": "ikruk.hades-api.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-ikruk-b",
            "match": "exact",
            "value": "hades-ikruk.api.gcp.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-psafronov-a",
            "match": "exact",
            "value": "psafronov.hades-api.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-psafronov-b",
            "match": "exact",
            "value": "hades-psafronov.api.gcp.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-yihao-a",
            "match": "exact",
            "value": "yihao.hades-api.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-personal-yihao-b",
            "match": "exact",
            "value": "hades-yihao.api.gcp.grok-sandbox.com",
            "reason": "Personal sandbox environment"
          },
          {
            "id": "exclude-staging-hades-a",
            "match": "exact",
            "value": "staging.hades-api.grok-sandbox.com",
            "reason": "Staging environment"
          },
          {
            "id": "exclude-staging-hades-b",
            "match": "exact",
            "value": "hades-staging.api.gcp.grok-sandbox.com",
            "reason": "Staging environment"
          },
          {
            "id": "exclude-staging-voice",
            "match": "exact",
            "value": "sip.staging.voice.x.ai",
            "reason": "Staging environment"
          },
          {
            "id": "exclude-staging-memy-a",
            "match": "exact",
            "value": "memy-09-staging.hades-api.grok-sandbox.com",
            "reason": "Staging environment"
          },
          {
            "id": "exclude-staging-memy-b",
            "match": "exact",
            "value": "hades-memy-09-staging.api.onprem.grok-sandbox.com",
            "reason": "Staging environment"
          },
          {
            "id": "exclude-staging-cm",
            "match": "exact",
            "value": "staging-cm-api.x.ai",
            "reason": "Staging environment"
          }
        ]
      },
      "runtime_candidate": {
        "enabled": true,
        "classification": {
          "enabled": true,
          "candidate_eligibility": {
            "enabled": true,
            "min_seen_days": 2,
            "min_observation_count": 2
          }
        }
      }
    }
  ]
}
